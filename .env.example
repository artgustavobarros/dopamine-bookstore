# OpenRouter API Configuration
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Modelo a ser utilizado na OpenRouter (padrão: openrouter/free)
#
# Modelos gratuitos verificados e ativos (:free):
# - openrouter/free (Roteador automático entre os modelos gratuitos disponíveis)
# - google/gemma-4-31b-it:free (Google Gemma 4 31B)
# - google/gemma-4-26b-a4b-it:free (Google Gemma 4 26B A4B)
# - qwen/qwen3.8-27b:free (Qwen 3.8 27B)
# - nvidia/nemotron-3.5-lightning:free (NVIDIA Nemotron 3.5 Lightning)
# - nvidia/nemotron-3-super-120b-a12b:free (NVIDIA Nemotron 3 Super)
#
# Modelos populares recomendados (caso possua créditos):
# - google/gemini-2.0-flash-001
# - openai/gpt-4o-mini
# - meta-llama/llama-3.3-70b-instruct
# - deepseek/deepseek-chat
OPENROUTER_MODEL="openrouter/free"

# Headers de identificação da aplicação na OpenRouter (HTTP-Referer e X-Title)
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_SITE_NAME="Depois Eu Leio"

# Ambiente de execução (development | production | test)
NODE_ENV="development"
