# Google Gemini API Configuration (Google AI Studio)
# Obtenha sua chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Modelo a ser utilizado no Google Gemini (padrão: gemini-flash-lite-latest)
#
# Modelos com Free Tier disponíveis no Google AI Studio:
# - gemini-flash-lite-latest (Recomendado: ultra-rápido, estável sob alta demanda, baixa latência)
# - gemini-3.5-flash-lite (Alternativa rápida e consistente)
# - gemini-3.8-flash (Modelo mais recente; pode sofrer 503 em horários de pico)
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_API_KEY=""

# Ambiente de execução (development | production | test)
NODE_ENV="development"
