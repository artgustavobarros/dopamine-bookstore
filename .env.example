# OpenRouter API Configuration (Free tier models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Model to use (defaults to openrouter/free)
# Alternatives: qwen/qwen3.8-27b:free, google/gemma-4-31b-it:free, nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL="openrouter/free"

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_SITE_NAME="Depois Eu Leio"
